# ---------------------------------------------------------------------------
# Stackd — environment variables
# Copy to .env.local (web) / .env (api). NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Claude Vision (apps/api only) -----------------------------------------
# Powers POST /verify-receipt. Put it in apps/api/.env — the API loads dotenv.
# NOTE: if this is exported in your shell, Claude Code bills the API instead of
# your subscription. `unset ANTHROPIC_API_KEY` if you want subscription billing.
ANTHROPIC_API_KEY=

# --- apps/api ---------------------------------------------------------------
PORT=4000

# Comma-separated origins allowed to call the API. Defaults to localhost:3000.
# Set this to the deployed web origin in production.
WEB_ORIGIN=http://localhost:3000

# Receipts above this USD total are refused rather than paid out. A blunt cap on
# how much a single bad extraction can cost the treasury.
MAX_RECEIPT_USD=1000

# --- STACKD bonus leg (backend only) ---------------------------------------
# NOTE: STACKD is a custom token, which contradicts the project rule "No custom
# token. Only xStocks from Backed Finance" and the landing copy "Not a token we
# invented". Leave STACKD_MINT blank to disable the bonus leg entirely — the
# xStock payout works without it and the UI treats a missing bonus as normal.
STACKD_MINT=
STACKD_DECIMALS=9
# Vault floor, in whole STACKD. Below this the bonus pauses instead of draining.
STACKD_MIN_VAULT_BALANCE=1000
# Fractional, NOT a percentage: 0.02 means 2%.
STACKD_BONUS_RATE=0.02

# --- Treasury (BACKEND ONLY — must never reach the browser) ----------------
# No NEXT_PUBLIC_ prefix. If you ever see this in apps/web, something is wrong.
TREASURY_PRIVATE_KEY=
TREASURY_PUBLIC_KEY=

# --- Solana RPC ------------------------------------------------------------
# Helius mainnet endpoint. Never use api.mainnet-beta.solana.com.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional. If set, the browser talks to this URL directly, which exposes the
# Helius key in the client bundle. Leave BLANK to route through /api/rpc, the
# server-side proxy that keeps HELIUS_RPC_URL private. Blank is recommended.
NEXT_PUBLIC_RPC_URL=

# --- Database ------------------------------------------------------
DATABASE_URL=

# --- Receipt image storage -----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Backend URL ---------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Transactional email -------------------------------------------
RESEND_API_KEY=

# --- Meteora DBC / $STACKD -----------------------------------------
# devnet | mainnet. Mainnet additionally requires DBC_ALLOW_MAINNET below,
# because genesis mints an immutable supply and cannot be undone.
DBC_CLUSTER=devnet
# DBC_ALLOW_MAINNET=I_UNDERSTAND_THIS_IS_PERMANENT

# Helius devnet endpoint for the DBC scripts. No public endpoints.
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Pays for config + pool creation; becomes partner fee claimer and pool creator.
DBC_PAYER_PRIVATE_KEY=

# Receives the 15% leftover bucket after migration.
STACKD_TEAM_PRIVATE_KEY=

# Rewards Vault that pays the bonus leg. NOTE: there is no genesis allocation
# for this — it is funded by claiming creator trading fees. See dbc.ts header.
STACKD_VAULT_PRIVATE_KEY=
STACKD_VAULT_PUBLIC_KEY=

# Set from the dbc:launch output.
DBC_CONFIG_ADDRESS=
DBC_POOL_ADDRESS=
DBC_PROGRAM_ID=dbcij3LWUppWqq96dh6gJWwBifmcGfLSB5D4DuSMaqN

# Optional: target DAMM v2 config for manual migration in the devnet sim.
DAMM_V2_CONFIG_ADDRESS=
