# ---------------------------------------------------------------------------
# Stackd — environment variables
# Copy to .env.local (web) / .env (api). NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Claude Vision (apps/api only) -----------------------------------------
# Powers POST /verify-receipt. Put it in apps/api/.env — the API loads dotenv.
# NOTE: if this is exported in your shell, Claude Code bills the API instead of
# your subscription. `unset ANTHROPIC_API_KEY` if you want subscription billing.
ANTHROPIC_API_KEY=
# Alternative: Claude through OpenRouter (same model, same request, OpenRouter
# credits). Set both lines below and leave ANTHROPIC_API_KEY empty — the sk-or-
# key goes in AUTH_TOKEN, not API_KEY. The model id gets its anthropic/ prefix
# automatically.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=

# --- apps/api ---------------------------------------------------------------
PORT=4000

# mainnet | devnet. The API reads SOLANA_CLUSTER; the web app reads
# NEXT_PUBLIC_SOLANA_CLUSTER (apps/web/.env.local). Unset means mainnet.
# A typo stops the server at boot rather than falling through to mainnet.
SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Enables GET /health/treasury (header: x-health-secret). 16+ characters;
# shorter or unset keeps the route disabled (404).
HEALTH_SECRET=

# Behind a hosting proxy (Railway, Render, Fly…) set to 1 so per-IP limits see
# the real client. Leave unset when nothing sits in front of the server.
TRUST_PROXY=

# --- Abuse limits and payout circuit breaker -------------------------------
WALLET_MAX_PER_DAY=3
IP_MAX_PER_HOUR=10
# Total Claude calls per hour across everyone: caps what a script can spend.
CLAUDE_MAX_PER_HOUR=60
# xStock cashback paid per UTC day, in USD. 0 pauses all payouts (kill switch).
DAILY_PAYOUT_CAP_USD=25
# Oldest receipt paid for: days between its printed date and submission, in
# UTC, with 24h of timezone grace. Future-dated receipts are refused too.
RECEIPT_MAX_AGE_DAYS=14

# Comma-separated origins allowed to call the API. Defaults to localhost:3000.
# Set this to the deployed web origin in production.
WEB_ORIGIN=http://localhost:3000

# Receipts above this USD total are refused rather than paid out. A blunt cap on
# how much a single bad extraction can cost the treasury.
MAX_RECEIPT_USD=1000
# Online orders (screenshots, emails, PDFs) earn cashback on at most this much of
# their total. They are the cheapest receipts to forge, and a careful fake has
# nothing in its pixels to disprove it, so this bounds what one fake can earn.
MAX_DIGITAL_RECEIPT_USD=100
# /health/treasury flags a brand whose xStock stock is worth less than this
# (USD). A brand with none at all is refused at /verify-receipt regardless.
LOW_STOCK_USD=2

# --- STACKD bonus leg (backend only) ---------------------------------------
# NOTE: STACKD is a custom token, which contradicts the project rule "No custom
# token. Only xStocks from Backed Finance" and the landing copy "Not a token we
# invented". Leave STACKD_MINT blank to disable the bonus leg entirely — the
# xStock payout works without it and the UI treats a missing bonus as normal.
STACKD_MINT=
STACKD_DECIMALS=9
# Vault floor, in whole STACKD. Below this the bonus pauses instead of draining.
STACKD_MIN_VAULT_BALANCE=1000
# Fractional, NOT a percentage: 0.02 means 2%.
STACKD_BONUS_RATE=0.02

# --- Treasury (BACKEND ONLY — must never reach the browser) ----------------
# No NEXT_PUBLIC_ prefix. If you ever see this in apps/web, something is wrong.
TREASURY_PRIVATE_KEY=
TREASURY_PUBLIC_KEY=

# --- Solana RPC ------------------------------------------------------------
# Helius mainnet endpoint. Never use api.mainnet-beta.solana.com.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional. If set, the browser talks to this URL directly, which exposes the
# Helius key in the client bundle. Leave BLANK to route through /api/rpc, the
# server-side proxy that keeps HELIUS_RPC_URL private. Blank is recommended.
NEXT_PUBLIC_RPC_URL=

# --- Database (Supabase Postgres) -----------------------------------------
# Supabase dashboard -> Connect -> "Session pooler" URI (IPv4-safe). Required on
# mainnet: the API refuses to start there without it. Unset = in-memory, which
# forgets receipts, limits and the payout budget on every restart.
DATABASE_URL=

# --- Receipt image storage -----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Backend URL ---------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Transactional email -------------------------------------------
RESEND_API_KEY=

# --- Meteora DBC / $STACKD -----------------------------------------
# devnet | mainnet. Mainnet additionally requires DBC_ALLOW_MAINNET below,
# because genesis mints an immutable supply and cannot be undone.
DBC_CLUSTER=devnet
# DBC_ALLOW_MAINNET=I_UNDERSTAND_THIS_IS_PERMANENT

# Helius devnet endpoint for the DBC scripts. No public endpoints.
# Same Helius key as mainnet — only the hostname differs.
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Pays for config + pool creation; becomes partner fee claimer and pool creator.
DBC_PAYER_PRIVATE_KEY=

# Receives the 15% leftover bucket after migration. FIXED FOREVER at genesis.
# Prefer a plain address (e.g. a Squads multisig VAULT address — not the
# multisig account itself); the key is only a fallback and never signs.
STACKD_TEAM_ADDRESS=
STACKD_TEAM_PRIVATE_KEY=
# Optional: who claims partner trading fees. FIXED FOREVER at genesis.
# Defaults to the DBC payer. A Squads vault address works here too.
DBC_FEE_CLAIMER_ADDRESS=

# Rewards Vault that pays the bonus leg. NOTE: there is no genesis allocation
# for this — it is funded by claiming creator trading fees. See dbc.ts header.
STACKD_VAULT_PRIVATE_KEY=
STACKD_VAULT_PUBLIC_KEY=

# Set from the dbc:launch output.
DBC_CONFIG_ADDRESS=
DBC_POOL_ADDRESS=
DBC_PROGRAM_ID=dbcij3LWUppWqq96dh6gJWwBifmcGfLSB5D4DuSMaqN

# Devnet ONLY: graduate at a lower threshold so the curve is reachable —
# Circle faucets ~10 USDC/hour, so 750 would take days. Applies when the pool
# config is BUILT (threshold is baked in at creation). Ignored on mainnet.
SIM_THRESHOLD_OVERRIDE_USDC=20

# Optional: target DAMM v2 config for manual migration in the devnet sim.
DAMM_V2_CONFIG_ADDRESS=
